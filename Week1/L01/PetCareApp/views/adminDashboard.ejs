
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pet Care Journal - Admin Dashboard</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="admin-page">

  <%- include('partials/navbar') %>

  <main class="admin-dashboard">

    <!-- Welcome section -->
    <section class="admin-welcome">
      <div>
        <p class="admin-eyebrow">PET CARE JOURNAL / ADMINISTRATION</p>
        <h1>Welcome back, <%= session.user.name %>!</h1>
        <p class="admin-welcome-text">
          Manage your community and keep everything running smoothly.
        </p>
      </div>

      <div class="admin-welcome-icon" aria-hidden="true">
        🐾
      </div>
    </section>

    <!-- Dashboard heading -->
    <section class="admin-section">
      <div class="admin-section-heading">
        <div>
          <h2>Your dashboard</h2>
          <p>Choose an area to manage.</p>
        </div>
      </div>

      <div class="admin-management-grid">

        <!-- Users -->
        <article class="admin-management-card">
          <div class="admin-card-icon users-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="10" cy="7" r="4"/>
              <path d="M20 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>

          <h3>Manage Users</h3>
          <p>
            View registered accounts and access your existing user-management tools.
          </p>

          <a href="/admin/users" class="admin-action-link">
            View all users <span aria-hidden="true">→</span>
          </a>
        </article>

        <!-- Pets -->
        <article class="admin-management-card">
          <div class="admin-card-icon pets-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round">
              <ellipse cx="12" cy="15.5" rx="5.5" ry="4.5"/>
              <ellipse cx="5.5" cy="9" rx="2" ry="2.5"/>
              <ellipse cx="10" cy="5.5" rx="2" ry="2.5"/>
              <ellipse cx="15" cy="5.5" rx="2" ry="2.5"/>
              <ellipse cx="19" cy="9" rx="2" ry="2.5"/>
            </svg>
          </div>

          <h3>Pet Profiles</h3>
          <p>
            Keep track of registered pets and their profile information.
          </p>

          <a href="/journals" class="admin-action-link">
            View pets journal <span aria-hidden="true">→</span>
          </a>
        </article>

        <!-- Journal entries -->
        <article class="admin-management-card">
          <div class="admin-card-icon journals-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 3h9l4 4v14H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/>
              <path d="M14 3v5h5"/>
              <path d="M8 13h8M8 17h8"/>
            </svg>
          </div>

          <h3>Journal Entries</h3>
          <p>
            Keep pet-care journal records organized and accessible.
          </p>

          <span class="admin-status-note">
            Journal management can be connected to your existing routes.
          </span>
        </article>

      </div>
    </section>

    <!-- Quick action -->
    <section class="admin-bottom-card">
      <div class="admin-bottom-icon" aria-hidden="true">💛</div>
      <div class="admin-bottom-copy">
        <h2>Keep your community organized</h2>
        <p>
          Start by reviewing registered users and their pet information.
        </p>
      </div>
      <a href="/admin/users" class="admin-primary-button">
        Manage users
      </a>
    </section>

  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
