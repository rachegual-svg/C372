<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Payment Result</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <%
    const alertClassByBooking = {
      CONFIRMED: 'alert-success',
      AWAITING_PAYMENT: 'alert-warning',
      PAYMENT_FAILED: 'alert-danger'
    };
    const messageByBooking = {
      CONFIRMED: 'Payment approved! Your booking is confirmed.',
      AWAITING_PAYMENT: 'Payment is pending. Your booking is awaiting payment.',
      PAYMENT_FAILED: 'Payment was declined. Your booking was not confirmed.'
    };
  %>

  <div class="container mt-5" style="max-width: 560px;">
    <h2 class="mb-4">Payment Result</h2>

    <div class="alert <%= alertClassByBooking[result.bookingStatus] || 'alert-secondary' %>">
      <%= messageByBooking[result.bookingStatus] || 'Unknown payment status.' %>
    </div>

    <div class="card mb-4">
      <div class="card-body">
        <table class="table mb-0">
          <tr>
            <th>Service</th>
            <td><%= service.name %></td>
          </tr>
          <tr>
            <th>Amount</th>
            <td>S$<%= service.price.toFixed(2) %></td>
          </tr>
          <tr>
            <th>Payment ID</th>
            <td><code><%= result.providerPaymentId %></code></td>
          </tr>
          <tr>
            <th>Reference</th>
            <td><%= result.merchantReference %></td>
          </tr>
          <tr>
            <th>Payment Status</th>
            <td><%= result.paymentStatus %></td>
          </tr>
          <tr>
            <th>Booking Status</th>
            <td><strong><%= result.bookingStatus %></strong></td>
          </tr>
        </table>
      </div>
    </div>

    <div class="d-flex gap-2">
      <a href="/services" class="btn btn-dark">Back to Services</a>
      <% if (result.bookingStatus !== 'CONFIRMED') { %>
        <a href="/payments/prepare/<%= service.id %>" class="btn btn-outline-secondary">Try Again</a>
      <% } %>
    </div>
  </div>

</body>
</html>
