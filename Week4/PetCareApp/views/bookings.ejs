<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Booking History</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bookings-page">
  <%- include('partials/navbar') %>

  <%
    // Maps a status (e.g. "AWAITING_PAYMENT") to a themed pill class.
    const statusClass = (status) =>
      'status-pill status-' + String(status || 'unknown').toLowerCase().replace(/_/g, '-');
  %>

  <main class="container">
    <div class="bookings-header">
      <div>
        <p class="bookings-eyebrow">YOUR APPOINTMENTS</p>
        <h1>Booking History</h1>
      </div>
      <a href="/services" class="btn btn-primary">Book a Service</a>
    </div>

    <% if (messages && messages.length) { %>
      <% for (let i = 0; i < messages.length; i++) { %>
        <div class="alert alert-success" role="status"><%= messages[i] %></div>
      <% } %>
    <% } %>
    <% if (errors && errors.length) { %>
      <% for (let i = 0; i < errors.length; i++) { %>
        <div class="alert alert-danger" role="alert"><%= errors[i] %></div>
      <% } %>
    <% } %>

    <% if (!bookings.length) { %>
      <div class="bookings-empty">
        <p class="mb-3">No bookings yet.</p>
        <a href="/services" class="btn btn-primary">Browse Services</a>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th scope="col">Booking #</th>
              <th scope="col">Date &amp; Time</th>
              <th scope="col">Pet</th>
              <th scope="col">Service</th>
              <th scope="col">Price</th>
              <th scope="col">Booking Status</th>
              <th scope="col">Payment Status</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% for (let i = 0; i < bookings.length; i++) { %>
              <% const b = bookings[i]; %>
              <tr>
                <td><%= b.booking_id %></td>
                <td class="text-nowrap"><%= b.booking_date %> · <%= b.time_slot %></td>
                <td><%= b.pet_name %></td>
                <td>
                  <% if (b.service_icon) { %><span class="service-icon" aria-hidden="true"><%= b.service_icon %></span><% } %>
                  <%= b.service_name %>
                </td>
                <td>S$<%= Number(b.booked_price).toFixed(2) %></td>
                <td><span class="<%= statusClass(b.booking_status) %>"><%= b.booking_status %></span></td>
                <td>
                  <% if (b.payment_status) { %>
                    <span class="<%= statusClass(b.payment_status) %>"><%= b.payment_status %></span>
                  <% } else { %>
                    <span class="text-muted">No payment record</span>
                  <% } %>
                </td>
                <td class="text-nowrap">
                  <% if (b.booking_status === 'pending') { %>
                    <a href="/bookings/<%= b.booking_id %>/reschedule" class="btn btn-sm btn-outline-secondary">Reschedule</a>
                    <form action="/bookings/<%= b.booking_id %>/cancel" method="POST" class="d-inline"
                          onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                      <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                    </form>
                  <% } else { %>
                    <span class="text-muted">—</span>
                  <% } %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <p class="bookings-note">Payments are pending. No payment has been processed by this app.</p>
    <% } %>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
