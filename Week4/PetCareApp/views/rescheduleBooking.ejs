<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Reschedule Booking</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="services-page">
  <%- include('partials/navbar') %>

  <main class="container">
    <div class="bookings-header">
      <div>
        <p class="bookings-eyebrow">BOOKING #<%= booking.booking_id %></p>
        <h1>Reschedule Booking</h1>
      </div>
      <a href="/bookings" class="btn btn-outline-secondary">Back to Booking History</a>
    </div>

    <% if (messages && messages.length) { %>
      <% for (let i = 0; i < messages.length; i++) { %>
        <div class="alert alert-success" role="status"><%= messages[i] %></div>
      <% } %>
    <% } %>
    <% if (errors && errors.length) { %>
      <% for (let i = 0; i < errors.length; i++) { %>
        <div class="alert alert-danger" role="alert"><%= errors[i] %></div>
      <% } %>
    <% } %>

    <div class="card service-summary mb-4">
      <div class="card-body">
        <p class="mb-1 service-name">
          <% if (booking.service_icon) { %><span class="service-icon" aria-hidden="true"><%= booking.service_icon %></span><% } %>
          <%= booking.service_name %> for <%= booking.pet_name %>
        </p>
        <p class="mb-0 service-meta">
          Currently: <%= booking.booking_date %> at <%= booking.time_slot %> ·
          Price stays S$<%= Number(booking.booked_price).toFixed(2) %>
        </p>
      </div>
    </div>

    <form action="/bookings/<%= booking.booking_id %>/reschedule" method="POST" class="services-form" id="rescheduleForm"
      data-service-id="<%= booking.service_id %>" data-pet-id="<%= booking.pet_id %>"
      data-booking-id="<%= booking.booking_id %>">
      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <label for="bookingDate" class="form-label">New date</label>
          <%# If the current date is already in the past, start the picker at today %>
          <input id="bookingDate" name="bookingDate" type="date" class="form-control"
            min="<%= today %>" value="<%= booking.booking_date < today ? today : booking.booking_date %>" required>
        </div>
      </div>

      <fieldset class="mb-4">
        <legend>New time slot</legend>
        <%- include('partials/slotPicker', { slotGroups, selectedSlot: booking.time_slot }) %>
        <p id="slotStatus" class="bookings-note mb-0" aria-live="polite"></p>
      </fieldset>

      <p class="bookings-note">Rescheduling does not change the price. No payment is processed here.</p>
      <button type="submit" class="btn btn-primary">Save new date and time</button>
    </form>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/slotAvailability.js"></script>
  <script>
    (function () {
      var form = document.getElementById('rescheduleForm');
      var dateInput = document.getElementById('bookingDate');

      function refreshSlots() {
        SlotAvailability.refresh({
          form: form,
          serviceId: form.getAttribute('data-service-id'),
          petId: form.getAttribute('data-pet-id'),
          excludeBookingId: form.getAttribute('data-booking-id'),
          date: dateInput.value,
          statusEl: document.getElementById('slotStatus')
        });
      }

      dateInput.addEventListener('change', refreshSlots);
      refreshSlots();
    })();
  </script>
</body>
</html>
