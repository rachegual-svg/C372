<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pet Care Journal System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">

  <!-- Three.js r160 for the 3D dog (no build step). Must come before the module script. -->
  <script type="importmap">
    {
      "imports": {
        "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
        "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
      }
    }
  </script>
</head>
<body class="home-page">
  <%- include('partials/navbar') %>

  <main class="home-hero">
    <div class="hero-grid">
      <!-- Left: title, welcome text and call to action -->
      <section class="hero-copy">
        <h1 class="hero-title"><span>Pet Care</span></h1>
        <p class="hero-welcome">Welcome To Your Pet Care Journal System</p>
        <% if (!session || !session.user) { %>
          <a href="/signup" class="hero-cta">Get Started</a>
        <% } else { %>
          <a href="/journals" class="hero-cta">View Journals</a>
        <% } %>
      </section>

      <!-- Right: interactive 3D dog -->
      <section class="hero-dog">
        <div id="dog-stage" tabindex="0" role="button"
             aria-label="Animated dog, press Enter to see a trick">
          <p id="dog-status" class="dog-status">Fetching the dog… 🐕</p>
        </div>
        <p id="dog-caption" class="dog-caption" aria-live="polite">Tap the dog! 🐾</p>
      </section>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script type="module" src="/js/dogScene.js"></script>
</body>
</html>
