<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pet Care Journal System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="home-page">
  <%- include('partials/navbar') %>

  <main class="home-hero">
    <div class="hero-art">
      <img
        src="/images/pet-care-home.png"
        alt="Illustration of a dog, cat, and rabbit beneath the Pet Care title"
        class="hero-illustration"
      >
      <% if (!session || !session.user) { %>
        <a href="/signup" class="bone-button">Get Started</a>
      <% } else { %>
        <a href="/journals" class="bone-button">View Journals</a>
      <% } %>
    </div>
  </main>
</body>
</html>
