<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pet Care Services</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <h2 class="mb-2">Our Services</h2>
    <p class="text-muted mb-4">Choose a service for your pet and book it online.</p>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger"><%= errors[0] %></div>
    <% } %>

    <div class="row g-4">
      <% services.forEach(function (service) { %>
        <div class="col-md-4">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><%= service.name %></h5>
              <p class="card-text text-muted"><%= service.description %></p>
              <p class="mb-1"><strong>Duration:</strong> <%= service.duration %></p>
              <p class="fs-4 fw-bold mb-3">S$<%= service.price.toFixed(2) %></p>
              <a href="/payments/prepare/<%= service.id %>" class="btn btn-dark mt-auto">Book &amp; Pay</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <% if (!session || !session.user) { %>
      <p class="text-muted mt-4">You will be asked to log in before paying.</p>
    <% } %>
  </div>

</body>
</html>
