
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pet Care Journal - Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">
<%- include('partials/navbar') %>
 

  <main class="auth-layout login-layout">

    <section class="auth-panel login-panel">
      <div class="auth-content">
        <h2>Login to Your Account</h2>

        <% if (errors && errors.length > 0) { %>
          <div class="alert alert-danger">
            <% errors.forEach(function(error) { %>
              <p><%= error %></p>
            <% }); %>
          </div>
        <% } %>

        <% if (messages && messages.length > 0) { %>
          <div class="alert alert-success">
            <% messages.forEach(function(message) { %>
              <p><%= message %></p>
            <% }); %>
          </div>
        <% } %>

        <form action="/login" method="POST">
          <div class="mb-3">
            <label for="username" class="form-label">Username:</label>
            <input type="text" class="form-control"
                   name="username" id="username" required>
          </div>

          <div class="mb-3">
            <label for="password" class="form-label">Password:</label>
            <input type="password" class="form-control"
                   name="password" id="password" required>
          </div>

          <button type="submit" class="btn auth-button w-100">
            Login
          </button>
        </form>

        <div class="auth-link">
          <a href="/signup">Don't have an account? Sign Up</a>
        </div>
      </div>
    </section>

    <section class="auth-illustration">
      <img src="/images/placeholder.png"
           alt="Pet care illustration">
    </section>

  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
